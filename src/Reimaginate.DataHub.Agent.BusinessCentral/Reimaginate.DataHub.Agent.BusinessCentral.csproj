<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>Microsoft Dynamics 365 Business Central integration agent for Reimaginate DataHub synchronization, merge processing, and OData access.</Description>
		<PackageTags>datahub;business-central;synchronization;agent</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="JsonDiffPatch.Net" Version="2.5.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
		<PackageReference Include="OneOf" Version="3.0.271" />
		<PackageReference Include="Reimaginate.DataHub.Client" Version="1.4.1" />
		<PackageReference Include="Reimaginate.DataHub.SharedModels" Version="1.4.1" />
		<PackageReference Include="Reimaginate.DataServices" Version="1.3.0" />
		<PackageReference Include="Reimaginate.Mapper" Version="1.3.0" />
		<PackageReference Include="Reimaginate.Mediator.Abstractions" Version="1.3.0" />
		<PackageReference Include="Reimaginate.ProcessingLockService" Version="2.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Reimaginate.DataHub.Agent.BusinessCentral.Abstractions\Reimaginate.DataHub.Agent.BusinessCentral.Abstractions.csproj" />
	</ItemGroup>

</Project>
