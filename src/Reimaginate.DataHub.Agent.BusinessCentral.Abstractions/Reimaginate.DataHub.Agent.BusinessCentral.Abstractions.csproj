<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Description>Lightweight contracts for Business Central entity models and Data Hub mappings.</Description>
    <PackageTags>datahub;business-central;abstractions;agent</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Reimaginate.DataHub.SharedModels" Version="1.4.1" />
  </ItemGroup>

</Project>
