{
  "Starter": {
    "WritesEnabled": false,
    "ScheduledProcessingEnabled": false,
    "AllowProductionWrites": false,
    "PollingIntervalSeconds": 60,
    "BatchSize": 100
  },
  "BusinessCentralAgentOptions": {
    "AgentId": "business-central-reference",
    "DataSource": "BusinessCentral",
    "Environment": "Sandbox",
    "ProcessingLockOptions": {
      "UseRepository": "InMemory"
    },
    "BusinessCentralServiceOptions": {
      "BaseUrl": "https://api.businesscentral.dynamics.com/v2.0/YOUR-TENANT-ID/YOUR-ENVIRONMENT/",
      "CompanyId": "YOUR-COMPANY-ID",
      "CompanyName": "YOUR-COMPANY-NAME",
      "ApiRoute": "api/v2.0",
      "CorrelationReservationsEnabled": false,
      "CorrelationApiRoute": "api/reimaginate/dataHub/v1.0",
      "MaxRetryAttempts": 3,
      "RetryBaseDelayMilliseconds": 250
    }
  },
  "DataHubClientOptions": {
    "DataHubClientUrl": "https://YOUR-DATAHUB-API/api/Client",
    "AuthenticationMode": "ManagedIdentity",
    "AzureAdScope": "api://YOUR-DATAHUB-API-CLIENT-ID/.default",
    "ManagedIdentityClientId": ""
  }
}
